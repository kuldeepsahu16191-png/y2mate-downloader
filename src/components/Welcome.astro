<script is:inline>
(function() {
  const API_BASE = typeof window !== 'undefined' && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
    ? 'http://localhost:5000'
    : 'https://y2mate-downloader-1.onrender.com'; // Update this to your deployed Python server URL

  // Translations Reference from loaded asset
  const TRANSLATIONS = window.Y2MATE_TRANSLATIONS || { en: {} };
  let currentLang = 'en';

  function getTranslation(key) {
    const dict = TRANSLATIONS[currentLang] || TRANSLATIONS['en'] || {};
    return dict[key] || TRANSLATIONS['en'][key] || '';
  }

  function setLanguage(lang) {
    if (!TRANSLATIONS[lang]) lang = 'en';
    currentLang = lang;
    localStorage.setItem('cq_y2mate_lang', lang);
    
    document.documentElement.dir = 'ltr';
    document.documentElement.lang = lang;
    
    // Update all elements with data-t
    document.querySelectorAll('[data-t]').forEach(el => {
      const key = el.getAttribute('data-t');
      const val = getTranslation(key);
      if (val) {
        el.innerHTML = val;
      }
    });

    // Update all elements with data-placeholder-t
    document.querySelectorAll('[data-placeholder-t]').forEach(el => {
      const key = el.getAttribute('data-placeholder-t');
      const val = getTranslation(key);
      if (val) {
        el.placeholder = val;
      }
    });

    // Update current code on display button
    const currentLangCodeEl = document.getElementById('current-lang-code');
    if (currentLangCodeEl) {
      currentLangCodeEl.textContent = lang;
    }

    // Mark current language active in dropdown list
    const dropdown = document.getElementById('lang-dropdown');
    if (dropdown) {
      dropdown.querySelectorAll('button').forEach(btn => {
        if (btn.getAttribute('data-lang') === lang) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // Rerender history list to apply language updates
    if (typeof renderHistory === 'function') renderHistory();
  }

  let currentVideoUrl = '';
  let resolvedVideoId = '';
  let activeFormatData = null; // Stored video info formats list
  let downloadHistory = [];

  function $(id) { return document.getElementById(id); }
  function show(el) { if(el) el.classList.remove('hidden'); }
  function hide(el) { if(el) el.classList.add('hidden'); }

  // Sound Engine Setup (synthesizing beep micro-sounds)
  let audioCtx = null;
  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
  }
  function playClick() {
    if (localStorage.getItem('cq_y2mate_muted') === 'true') return;
    try {
      initAudio();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.08);
      gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.08);
    } catch(e) {}
  }
  
  function playCompleteSound() {
    if (localStorage.getItem('cq_y2mate_muted') === 'true') return;
    try {
      initAudio();
      const now = audioCtx.currentTime;
      // High pitch double-chime
      [523.25, 659.25].forEach((freq, idx) => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + idx * 0.1);
        gain.gain.setValueAtTime(0.06, now + idx * 0.1);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.3);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now + idx * 0.1);
        osc.stop(now + idx * 0.1 + 0.3);
      });
    } catch(e) {}
  }

  // Load and Render History Dashboard
  function loadHistory() {
    const raw = localStorage.getItem('cq_y2mate_history');
    if (raw) {
      downloadHistory = JSON.parse(raw);
    } else {
      downloadHistory = [];
    }
    renderHistory();
  }

  function saveHistory() {
    localStorage.setItem('cq_y2mate_history', JSON.stringify(downloadHistory));
    renderHistory();
  }

  function addHistoryItem(title, quality, type, id) {
    // Keep it unique: remove duplicates of the same video and quality
    downloadHistory = downloadHistory.filter(item => !(item.id === id && item.quality === quality));
    
    downloadHistory.unshift({
      title: title,
      quality: quality,
      type: type,
      id: id,
      date: new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
    });

    // Cap history length at 5
    if (downloadHistory.length > 5) {
      downloadHistory.pop();
    }
    saveHistory();
  }

  function deleteHistoryItem(id, quality) {
    playClick();
    downloadHistory = downloadHistory.filter(item => !(item.id === id && item.quality === quality));
    saveHistory();
  }

  function renderHistory() {
    const tbody = $('history-rows');
    if (!tbody) return;
    
    if (downloadHistory.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="empty-state text-muted">
            ${getTranslation('empty_history')}
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = '';
    downloadHistory.forEach(item => {
      const row = document.createElement('tr');
      const safeTitle = item.title.replace(/"/g, '&quot;');
      row.innerHTML = `
        <td class="col-title-cell">
          <div class="history-title-cell" title="${safeTitle}">${item.title}</div>
        </td>
        <td class="col-action-cell" style="text-align: center; white-space: nowrap;">
          <button class="btn-history-dl" data-id="${item.id}" data-title="${safeTitle}" data-quality="${item.quality}" data-type="${item.type}" title="Redownload">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
