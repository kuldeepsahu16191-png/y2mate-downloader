  // Google Autocomplete Search Suggestion JSONP trigger
  let lastSearchVal = '';
  let autocompleteTimer = null;

  async function updateSuggestions() {
    const val = $('url-input').value.trim();
    const dropdown = $('suggestions-dropdown');
    
    if (!val || val === lastSearchVal) {
      if (!val) hide(dropdown);
      return;
    }
    lastSearchVal = val;

    // Do not suggest if it looks like a URL
    if (val.startsWith('http://') || val.startsWith('https://') || val.includes('youtube.com') || val.includes('youtu.be')) {
      hide(dropdown);
      return;
    }

    // JSONP trigger
    const callbackName = 'jsonp_autocomplete_' + Math.round(100000 * Math.random());
    window[callbackName] = function(data) {
      delete window[callbackName];
      const oldScript = $(callbackName + '_script');
      if (oldScript) document.body.removeChild(oldScript);
      
      const suggestions = data && data[1] ? data[1] : [];
      renderSuggestions(suggestions);
    };

    const oldScript = $(callbackName + '_script');
    if (oldScript) document.body.removeChild(oldScript);

    const script = document.createElement('script');
    script.id = callbackName + '_script';
    script.src = `https://suggestqueries.google.com/complete/search?client=youtube&ds=yt&q=${encodeURIComponent(val)}&jsonp=${callbackName}`;
    document.body.appendChild(script);
  }

  function renderSuggestions(list) {
    const dropdown = $('suggestions-dropdown');
    if (!list || list.length === 0) {
      hide(dropdown);
      return;
    }

    dropdown.innerHTML = '';
    list.slice(0, 6).forEach(item => {
      const div = document.createElement('div');
      div.className = 'suggestion-item';
      div.innerHTML = `
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>${item[0]}</span>
      `;
      div.addEventListener('click', function() {
        $('url-input').value = item[0];
        hide(dropdown);
        playClick();
        handleSearch();
      });
      dropdown.appendChild(div);
    });

    show(dropdown);
  }

  function isYouTubeUrl(url) {
    const patterns = [
      /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/v\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
      /^([a-zA-Z0-9_-]{11})$/
    ];
    for (const pattern of patterns) {
      if (pattern.test(url)) return true;
    }
    return false;
  }

  // Handle YouTube URL details parsing
  async function handleSearch() {
    const val = $('url-input').value.trim();
    hide($('error-state'));
    hide($('results-section'));
    hide($('search-results-section'));
    hide($('suggestions-dropdown'));
    
    if (!val) {
      showError(getTranslation('error_invalid') || 'Please enter a YouTube video URL or search keywords');
      return;
    }

    playClick();
    show($('loading-state'));
    $('search-btn').disabled = true;
    $('search-btn').querySelector('.btn-text').classList.add('hidden');
    $('search-btn').querySelector('.btn-spinner').classList.remove('hidden');

    if (isYouTubeUrl(val)) {
      try {
        const resp = await fetch(API_BASE + '/api/info?url=' + encodeURIComponent(val));
        const data = await resp.json();

        $('search-btn').disabled = false;
        $('search-btn').querySelector('.btn-text').classList.remove('hidden');
        $('search-btn').querySelector('.btn-spinner').classList.add('hidden');
        hide($('loading-state'));

        if (!resp.ok || data.error) {
          throw new Error(data.error || 'Failed to fetch video information');
        }

        // Populate Visual Mockup Player Details
        resolvedVideoId = data.id;
        currentVideoUrl = 'https://www.youtube.com/watch?v=' + data.id;
        activeFormatData = data;
        
        $('browser-url-label').textContent = 'youtube.com/watch?v=' + data.id;
        $('preview-iframe').src = `https://www.youtube.com/embed/${data.id}?autoplay=0&rel=0`;
        
        $('video-title').textContent = data.title;
        $('video-channel').textContent = data.channel;
        $('txt-duration').textContent = data.duration_formatted;
        $('txt-views').textContent = formatNumber(data.view_count) + ' ' + getTranslation('views');
        $('txt-likes').textContent = formatNumber(data.like_count) + ' ' + getTranslation('likes');

        // Build Format Quality Option Rows
        buildFormatOptions(data);

        // Display results band
        show($('results-section'));
        
        // Smooth scroll to results
        $('results-section').scrollIntoView({ behavior: 'smooth', block: 'start' });

      } catch (err) {
        $('search-btn').disabled = false;
        $('search-btn').querySelector('.btn-text').classList.remove('hidden');
        $('search-btn').querySelector('.btn-spinner').classList.add('hidden');
        hide($('loading-state'));
        showError(err.message || 'Failed to analyze video. Is the backend server running?');
      }
    } else {
      // Keyword search
      try {
        const resp = await fetch(API_BASE + '/api/search?q=' + encodeURIComponent(val));
        const data = await resp.json();

        $('search-btn').disabled = false;
        $('search-btn').querySelector('.btn-text').classList.remove('hidden');
        $('search-btn').querySelector('.btn-spinner').classList.add('hidden');
        hide($('loading-state'));

        if (!resp.ok || data.error) {
          throw new Error(data.error || 'Failed to fetch search results');
        }

        const grid = $('search-results-grid');
        grid.innerHTML = '';

        if (!data.results || data.results.length === 0) {
          showError('No results found for your search query');
          return;
        }

        data.results.forEach(video => {
          const card = document.createElement('div');
          card.className = 'search-result-card';
          card.setAttribute('data-id', video.id);
          card.innerHTML = `
            <div class="card-thumbnail-wrapper">
              <img class="card-thumbnail" src="${video.thumbnail}" alt="${video.title.replace(/"/g, '&quot;')}" loading="lazy" />
              <span class="card-duration">${video.duration_formatted}</span>
              <div class="card-cta-overlay"></div>
            </div>
            <div class="card-content">
              <h3 class="card-title" title="${video.title.replace(/"/g, '&quot;')}">${video.title}</h3>
              <div class="card-meta">
                <span class="card-channel">${video.channel}</span>
                <span class="card-views">${video.view_count_formatted} views</span>
              </div>
            </div>
          `;
          card.addEventListener('click', function() {
            $('url-input').value = 'https://www.youtube.com/watch?v=' + video.id;
            hide($('search-results-section'));
            handleSearch();
          });
          grid.appendChild(card);
        });

        show($('search-results-section'));
        $('search-results-section').scrollIntoView({ behavior: 'smooth', block: 'start' });

      } catch (err) {
        $('search-btn').disabled = false;
        $('search-btn').querySelector('.btn-text').classList.remove('hidden');
        $('search-btn').querySelector('.btn-spinner').classList.add('hidden');
        hide($('loading-state'));
        showError(err.message || 'Failed to search YouTube. Is the backend server running?');
      }
    }
  }

  function formatNumber(num) {
    if (!num) return '0';
    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
    if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
    return num.toString();
  }

  function showError(msg) {
    const el = $('error-state');
    $('error-message').textContent = msg;
    show(el);
    // Beep warning sound
    if (localStorage.getItem('cq_y2mate_muted') !== 'true') {
      try {
        initAudio();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.2);
      } catch(e) {}
    }
  }

