  // Common Download Trigger with custom smooth progress indicators
  function initiateDownloadProcess(btn, quality, type, title) {
    if (!currentVideoUrl) {
      alert(getTranslation('alert_search_first'));
      return;
    }

    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<div class="spinner" style="width:14px;height:14px;border-width:2px;border-top-color:currentColor;"></div> ${getTranslation('processing')}`;

    // Show custom progress bar
    const progressBox = $('download-progress');
    const fill = $('progress-fill');
    const txt = $('progress-text');
    const pct = $('progress-percent');

    show(progressBox);
    fill.style.width = '10%';
    txt.textContent = getTranslation('contacting_api') || 'Preparing download...';
    pct.textContent = '10%';

    const ext = btn.getAttribute('data-ext') || 'mp3';
    const downloadUrl = API_BASE + '/api/download';

    fetch(downloadUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        url: currentVideoUrl, 
        quality: quality, 
        type: type,
        is_vertical: activeFormatData ? activeFormatData.is_vertical : false,
        ext: ext
      })
    })
    .then(resp => {
      if (!resp.ok) {
        return resp.json().then(err => {
          throw new Error(err.error || 'Failed to start download. Server returned status ' + resp.status);
        });
      }
      return resp.json();
    })
    .then(data => {
      const taskId = data.task_id;
      pollStatus(taskId);
    })
    .catch(err => {
      hide(progressBox);
      alert((getTranslation('dl_failed') || 'Download Failed: ') + err.message);
      btn.innerHTML = originalHTML;
      btn.disabled = false;
    });

    function pollStatus(taskId) {
      const statusUrl = API_BASE + '/api/download/status/' + taskId;

      fetch(statusUrl)
      .then(resp => {
        if (!resp.ok) {
          throw new Error('Failed to get download status');
        }
        return resp.json();
      })
      .then(task => {
        if (task.status === 'failed') {
          throw new Error(task.error || 'Download failed on server');
        }

        if (task.status === 'pending') {
          fill.style.width = '10%';
          pct.textContent = '10%';
          txt.textContent = getTranslation('contacting_api') || 'Preparing download...';
          setTimeout(() => pollStatus(taskId), 1000);
        } else if (task.status === 'downloading') {
          const rawProgress = task.progress || 0;
          const displayPct = 10 + (rawProgress * 0.75); // scale 0-100 to 10-85
          fill.style.width = Math.min(85, Math.round(displayPct)) + '%';
          pct.textContent = Math.round(rawProgress) + '%';

          let speedEtaStr = '';
          if (task.speed && task.eta) {
            speedEtaStr = ' (' + task.speed + ', ETA: ' + task.eta + ')';
          }
          txt.textContent = (getTranslation('downloading_streams') || 'Downloading media data streams...') + speedEtaStr;
          setTimeout(() => pollStatus(taskId), 1000);
        } else if (task.status === 'processing') {
          fill.style.width = '90%';
          pct.textContent = '90%';
          txt.textContent = type === 'audio' 
            ? (getTranslation('converting_audio') || 'Converting audio tracks to MP3...') 
            : (getTranslation('merging_streams') || 'Merging high-quality DASH video streams...');
          setTimeout(() => pollStatus(taskId), 1000);
        } else if (task.status === 'completed') {
          fill.style.width = '95%';
          pct.textContent = '95%';
          txt.textContent = getTranslation('packaging_file') || 'Packaging converted file...';

          fetch(API_BASE + '/api/download/file/' + taskId)
          .then(fileResp => {
            if (!fileResp.ok) {
              throw new Error('Failed to retrieve file from server');
            }
            return fileResp.blob();
          })
          .then(blob => {
            fill.style.width = '100%';
            pct.textContent = '100%';
            txt.textContent = getTranslation('dl_completed') || 'Download completed!';
            playCompleteSound();

            const fileExt = type === 'audio' ? ext : 'mp4';
            const safeFilename = title.replace(/[^a-zA-Z0-9_\- ]/g, '_') + '.' + fileExt;

            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = safeFilename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            addHistoryItem(title, quality, type, resolvedVideoId);

            setTimeout(() => {
              URL.revokeObjectURL(a.href);
              hide(progressBox);
              fill.style.width = '0%';
            }, 4000);

            btn.innerHTML = originalHTML;
            btn.disabled = false;
          })
          .catch(err => {
            hide(progressBox);
            alert((getTranslation('dl_failed') || 'Download Failed: ') + err.message);
            btn.innerHTML = originalHTML;
            btn.disabled = false;
          });
        }
      })
      .catch(err => {
        hide(progressBox);
        alert((getTranslation('dl_failed') || 'Download Failed: ') + err.message);
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      });
    }
  }

  // Keyboard navigation for Search Suggestions dropdown
  $('url-input').addEventListener('keyup', function(e) {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter') {
      const dropdown = $('suggestions-dropdown');
      if (dropdown && !dropdown.classList.contains('hidden')) {
        const items = dropdown.querySelectorAll('.suggestion-item');
        if (items.length > 0) {
          let activeIndex = -1;
          items.forEach((item, idx) => {
            if (item.classList.contains('active')) activeIndex = idx;
          });

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (activeIndex !== -1) items[activeIndex].classList.remove('active');
            activeIndex = (activeIndex + 1) % items.length;
            items[activeIndex].classList.add('active');
            $('url-input').value = items[activeIndex].querySelector('span').textContent;
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (activeIndex !== -1) items[activeIndex].classList.remove('active');
            activeIndex = (activeIndex - 1 + items.length) % items.length;
            items[activeIndex].classList.add('active');
            $('url-input').value = items[activeIndex].querySelector('span').textContent;
          } else if (e.key === 'Enter') {
            if (activeIndex !== -1) {
              hide(dropdown);
              handleSearch();
            }
          }
          return;
        }
      }
    }

    // Debounce autocomplete suggestions trigger
    if (autocompleteTimer) clearTimeout(autocompleteTimer);
    autocompleteTimer = setTimeout(updateSuggestions, 200);
  });

