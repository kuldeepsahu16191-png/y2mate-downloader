  // Load language on initialization
  const initialLang = localStorage.getItem('cq_y2mate_lang') || 'en';
  setLanguage(initialLang);

  // Check for url query parameter on load
  const urlParams = new URLSearchParams(window.location.search);
  const queryUrl = urlParams.get('url');
  if (queryUrl) {
    const decodedUrl = decodeURIComponent(queryUrl);
    const inputEl = $('url-input');
    if (inputEl) {
      inputEl.value = decodedUrl;
      setTimeout(() => {
        handleSearch();
      }, 300);
    }
  }
})();
</script>
